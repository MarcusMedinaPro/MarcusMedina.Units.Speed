<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageId>MarcusMedina.Units.Speed</PackageId>
    <Version>0.1.0</Version>
    <Title>MarcusMedina.Units.Speed</Title>
    <Description>Fluent speed unit conversion — metric, US, nautical and scientific (m/s, km/h, mph, knots, Mach, c).</Description>
    <Authors>Marcus Medina</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/MarcusMedinaPro/MarcusMedina.Units.Speed</RepositoryUrl>
    <PackageTags>speed;velocity;units;conversion;fluent;metric;mph;knots;mach</PackageTags>
    <NoWarn>CS1573;CS1591</NoWarn>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>MarcusMedina.Units.Speed</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\..\assets\open-source.svg" Pack="true" PackagePath="assets\" />
  </ItemGroup>
</Project>
